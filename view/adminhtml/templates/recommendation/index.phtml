                                <summary class="action-primary"><?= $escaper->escapeHtml(__('Mark as applied')) ?></summary>
                                <form method="post" action="<?= $escaper->escapeUrl($block->getPostUrl('apply')) ?>">
                                    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                    <input type="hidden" name="rec_id" value="<?= (int)$recId ?>"/>
                                    <?= /* @noEscape */ $storeField ?>
                                    <label for="panth-aiv-rec-note-<?= (int)$recId ?>"><?= $escaper->escapeHtml(
                                        __('What did you change? (optional)')
                                    ) ?></label>
                                    <textarea id="panth-aiv-rec-note-<?= (int)$recId ?>" name="note" rows="2"
