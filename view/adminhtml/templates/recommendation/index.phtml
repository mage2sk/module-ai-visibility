                        $metric = (string)($action['metric'] ?? '');
                        $impactRow = $action['impact'];
                        $tone = $block->getActionTone($action);
                        $subjectCount = count($action['subjects']);
                        ?>
                        <tr>
                            <td>
                                <span class="panth-aiv__label"><?= $escaper->escapeHtml((string)$action['title']) ?></span>
                                <span class="panth-aiv__path"><?= $escaper->escapeHtml(__(
                                    'Measured: %1',
                                    $presenter->metricLabel($metric)
                                )) ?><?php if ($subjectCount > 1): ?>, <?= $escaper->escapeHtml(__('%1 items', $subjectCount)) ?><?php endif; ?></span>
                                <?php if (trim((string)($action['note'] ?? '')) !== ''): ?>
                                    <span class="panth-aiv__path"><?= $escaper->escapeHtml(__('Note: %1', (string)$action['note'])) ?></span>
                                <?php endif; ?>
                                <?php if ((int)($action['is_simulated'] ?? 0) === 1): ?>
                                    <span class="panth-aiv__path"><em><?= $escaper->escapeHtml(__('Simulated test data')) ?></em></span>
                                <?php endif; ?>
                            </td>
                            <td>
                                <?= $escaper->escapeHtml($block->formatUtcDate((string)($action['applied_at'] ?? ''))) ?>
                                <span class="panth-aiv__path"><?= $escaper->escapeHtml(__('by %1', $block->getAppliedBy($action))) ?></span>
                            </td>
                            <td>
                                <span class="panth-aiv-rec__verdict panth-aiv-rec__verdict--<?= $escaper->escapeHtmlAttr($tone) ?>"><?= $escaper->escapeHtml(
                                    $block->getActionStatusText($action)
                                ) ?></span>
                                <?php if ($impactRow !== null && $tone !== 'undone' && $tone !== 'pending'): ?>
                                    <span class="panth-aiv__path"><?= $escaper->escapeHtml($presenter->methodSentence($impactRow)) ?></span>
                                <?php endif; ?>
                            </td>
                            <td><?= /* @noEscape */ $block->getBarsSvg($action) ?></td>
                            <?php if ($undoColumn): ?>
                            <td class="panth-aiv-rec__action-col">
                                <?php if ($block->canUndo($action)): ?>
                                    <details class="panth-aiv-rec__confirm panth-aiv-rec__confirm--end">
                                        <summary class="action-default"><?= $escaper->escapeHtml(__('Undo')) ?></summary>
                                        <form method="post" action="<?= $escaper->escapeUrl($block->getPostUrl('undo')) ?>">
                                            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                            <input type="hidden" name="action_id" value="<?= (int)$actionId ?>"/>
                                            <?= /* @noEscape */ $storeField ?>
                                            <p><?= $escaper->escapeHtml(__('Use this when you reverted the change. It will not be verified.')) ?></p>
                                            <button type="submit" class="action-default"><?= $escaper->escapeHtml(__('Confirm undo')) ?></button>
                                        </form>
                                    </details>
                                <?php endif; ?>
                            </td>
                            <?php endif; ?>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
                <p class="panth-aiv__muted"><?= $escaper->escapeHtml(__(
