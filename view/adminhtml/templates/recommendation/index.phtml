                            <div>
                                <dt><?= $escaper->escapeHtml(__('Affected')) ?></dt>
                                <dd><?= $escaper->escapeHtml(number_format((int)($rec['affected_count'] ?? 0))) ?></dd>
                            </div>
                            <?php foreach ($facts as $fact): ?>
                                <div>
                                    <dt><?= $escaper->escapeHtml($fact['label']) ?></dt>
                                    <dd><?= $escaper->escapeHtml($fact['value']) ?></dd>
                                </div>
                            <?php endforeach; ?>
                        </dl>

                        <?php if ($examples !== []): ?>
                            <div class="panth-aiv-rec__examples">
                                <strong><?= $escaper->escapeHtml(__('Top examples')) ?></strong>
                                <ul>
                                    <?php foreach ($examples as $example): ?>
                                        <li><code><?= $escaper->escapeHtml($example) ?></code></li>
                                    <?php endforeach; ?>
                                </ul>
                            </div>
                        <?php endif; ?>

