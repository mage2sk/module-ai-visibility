                                <?php endif; ?>
                                <?php if ($link !== null): ?>
                                    <a href="<?= $escaper->escapeUrl($link['url']) ?>"><?= $escaper->escapeHtml($link['label']) ?></a>
                                <?php endif; ?>
                            </div>
                        <?php endif; ?>

