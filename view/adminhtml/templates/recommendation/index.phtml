                                    <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                    <input type="hidden" name="rec_id" value="<?= (int)$recId ?>"/>
                                    <?= /* @noEscape */ $storeField ?>
                                    <p><?= $escaper->escapeHtml(__('It is hidden and not suggested again for 30 days.')) ?></p>
                                    <button type="submit" class="action-default"><?= $escaper->escapeHtml(
                                        __('Confirm dismiss')
                                    ) ?></button>
                                </form>
                            </details>
                            <form class="panth-aiv-rec__feedback" method="post"
                                  action="<?= $escaper->escapeUrl($block->getPostUrl('feedback')) ?>">
                                <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>"/>
                                <input type="hidden" name="rec_id" value="<?= (int)$recId ?>"/>
                                <?= /* @noEscape */ $storeField ?>
                                <span class="panth-aiv__muted"><?= $escaper->escapeHtml(__('Was this helpful?')) ?></span>
                                <button type="submit" name="value" value="1"
                                        class="action-default<?= $feedback === 1 ? ' _active' : '' ?>"
                                        aria-pressed="<?= $feedback === 1 ? 'true' : 'false' ?>"><?= $escaper->escapeHtml(__('Useful')) ?></button>
                                <button type="submit" name="value" value="-1"
                                        class="action-default<?= $feedback === -1 ? ' _active' : '' ?>"
                                        aria-pressed="<?= $feedback === -1 ? 'true' : 'false' ?>"><?= $escaper->escapeHtml(__('Not useful')) ?></button>
                            </form>
                        </div>
                    </li>
                <?php endforeach; ?>
            </ol>
        <?php endif; ?>
    </section>

    <section class="panth-aiv-rec__section" aria-labelledby="panth-aiv-rec-applied-title">
        <h2 id="panth-aiv-rec-applied-title" class="panth-aiv__h"><?= $escaper->escapeHtml(__('Applied & verified')) ?></h2>
        <?php if ($actions === []): ?>
            <div class="panth-aiv__card panth-aiv-rec__empty">
                <p><?= $escaper->escapeHtml(__('No fixes applied yet.')) ?></p>
                <p class="panth-aiv__muted"><?= $escaper->escapeHtml(__(
                    'When you mark a recommendation as applied it is listed here, with the measured effect once '
