<?php
/**
 * Copyright © Panth Infotech. All rights reserved.
 *
 * AI attribution section on the admin order view page.
 *
 * @var \Panth\AiVisibility\Block\Adminhtml\Order\View\Attribution $block
 * @var \Magento\Framework\Escaper $escaper
 */
$row = $block->getAttribution();
if ($row === null) {
    return;
}
$credited = $block->getCreditedSource();
$landing = (string)($row['landing_path'] ?? '');
?>
<section class="admin__page-section panth-aiv-order-attribution">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('AI Attribution')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <?php if (!empty($row['is_simulated'])): ?>
            <div class="message message-notice">
                <?= $escaper->escapeHtml(__('This attribution was generated by the traffic simulator.')) ?>
            </div>
        <?php endif; ?>
        <table class="admin__table-secondary">
            <tbody>
            <tr>
                <th><?= $escaper->escapeHtml(__('Credited Source')) ?></th>
                <td>
                    <strong><?= $escaper->escapeHtml($block->getSourceName($credited)) ?></strong>
                    (<?= $escaper->escapeHtml(
                        $block->isLastTouchModel() ? __('last touch') : __('first touch')
                    ) ?>)
                </td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('First Touch')) ?></th>
                <td>
                    <?= $escaper->escapeHtml($block->getSourceName($row['first_source'] ?? '')) ?>
                    <?php $firstAt = $block->formatUtc($row['first_at'] ?? ''); ?>
                    <?php if ($firstAt !== ''): ?>
                        &middot; <?= $escaper->escapeHtml($firstAt) ?>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <th><?= $escaper->escapeHtml(__('Last Touch')) ?></th>
                <td>
                    <?= $escaper->escapeHtml($block->getSourceName($row['last_source'] ?? '')) ?>
                    <?php $lastAt = $block->formatUtc($row['last_at'] ?? ''); ?>
                    <?php if ($lastAt !== ''): ?>
                        &middot; <?= $escaper->escapeHtml($lastAt) ?>
                    <?php endif; ?>
                </td>
            </tr>
            <?php if ($landing !== ''): ?>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Landing Page')) ?></th>
                    <td><code><?= $escaper->escapeHtml($landing) ?></code></td>
                </tr>
            <?php endif; ?>
            <tr>
                <th><?= $escaper->escapeHtml(__('Channel')) ?></th>
                <td><?= $escaper->escapeHtml($block->getChannelLabel($row['channel'] ?? '')) ?></td>
            </tr>
            </tbody>
        </table>
    </div>
</section>
