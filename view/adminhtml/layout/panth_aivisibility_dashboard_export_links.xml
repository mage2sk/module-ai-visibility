 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Panth\AiVisibility\Block\Adminhtml\ExportLinks"
                   name="panth_aiv.export_links"
                   after="panth_aiv.dashboard"
                   template="Panth_AiVisibility::dashboard/export_links.phtml"
                   aclResource="Panth_AiVisibility::dashboard"/>
        </referenceContainer>
    </body>
</page>
