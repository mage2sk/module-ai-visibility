<!--
/**
 * Copyright © Panth Infotech. All rights reserved.
 *
 * Admin pages live under the shared "Panth Infotech" parent defined by
 * Panth_Core. The configuration section has its own resource under
 * Stores > Configuration, the same way Panth_Core declares its own.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Panth_Core::panth_extensions">
                    <resource id="Panth_AiVisibility::aivisibility" title="AI Visibility" sortOrder="97">
                        <resource id="Panth_AiVisibility::dashboard" title="Dashboard" sortOrder="10"/>
                        <resource id="Panth_AiVisibility::log" title="Crawler Log" sortOrder="20"/>
                        <resource id="Panth_AiVisibility::discovery" title="Discovery" sortOrder="30"/>
                        <resource id="Panth_AiVisibility::recommendations" title="Recommendations" sortOrder="40"/>
                    </resource>
                </resource>

                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Panth_AiVisibility::config" title="Panth AI Visibility" sortOrder="197"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
